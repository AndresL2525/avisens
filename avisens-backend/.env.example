# =============================================================================
# AVÍSENS Backend - Variables de Entorno
# =============================================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a Git (ya está en .gitignore).

# -----------------------------------------------------------------------------
# 1. MongoDB Atlas (o local)
# -----------------------------------------------------------------------------
# Obtén tu URI en: MongoDB Atlas → Database → Connect → Drivers → Python
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/avisens?retryWrites=true&w=majority
MONGODB_DB_NAME=avisens

# -----------------------------------------------------------------------------
# 2. Seguridad JWT
# -----------------------------------------------------------------------------
# Genera una clave secreta FUERTE (mínimo 256 bits):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=tu_clave_secreta_muy_larga_aqui_minimo_32_caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_DEVICE_TOKEN_EXPIRE_DAYS=365

# -----------------------------------------------------------------------------
# 3. API / Servidor
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 4. Rate Limiting
# -----------------------------------------------------------------------------
# Requests por minuto por IP (endpoints públicos)
RATE_LIMIT_PER_MINUTE=60
# Requests por minuto para el ESP32 (endpoints de sensores)
DEVICE_RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 5. CORS (origines permitidos para apps web/móvil)
# -----------------------------------------------------------------------------
# En producción, lista exacta de dominios. En dev, deja * para pruebas.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://tu-app.com

# -----------------------------------------------------------------------------
# 6. Dispositivos autorizados (ESP32)
# -----------------------------------------------------------------------------
# Lista de device IDs separados por coma. Cada ESP32 debe tener un ID único.
# Estos IDs se usan para generar tokens de dispositivo.
AUTHORIZED_DEVICE_IDS=galpon_01,galpon_02

# -----------------------------------------------------------------------------
# 7. Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
